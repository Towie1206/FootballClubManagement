<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phui_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Thẻ cầu thủ Hero (Shared Element) -->
        <LinearLayout
            android:id="@+id/detailCardRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:transitionName="player_card_transition"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/tvDetailOvr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85"
                    android:textColor="@color/phui_accent"
                    android:textSize="54sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvDetailPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FW"
                    android:textColor="@color/phui_text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn A"
                android:textColor="@color/phui_text_primary"
                android:textSize="30sp"
                android:textStyle="bold"/>
                
            <TextView
                android:id="@+id/tvDetailJersey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Số áo: 9"
                android:textColor="@color/phui_accent"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Chỉ số chi tiết (FIFA Style Progress Bars) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHÂN TÍCH CHỈ SỐ"
            android:textColor="@color/phui_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="32dp">

            <!-- Tốc độ / Thể lực -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thể lực &amp; Tốc độ (PAC)"
                android:textColor="@color/phui_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>
            <ProgressBar
                android:id="@+id/progressPac"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progressDrawable="@drawable/custom_progress"
                android:progress="85"
                android:layout_marginBottom="16dp"/>

            <!-- Sút / Ghi bàn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dứt điểm (SHO) - Dựa trên bàn thắng"
                android:textColor="@color/phui_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>
            <ProgressBar
                android:id="@+id/progressSho"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progressDrawable="@drawable/custom_progress"
                android:progress="70"
                android:layout_marginBottom="16dp"/>

            <!-- Đóng góp MVP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tầm ảnh hưởng (MVP)"
                android:textColor="@color/phui_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>
            <ProgressBar
                android:id="@+id/progressMvp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progressDrawable="@drawable/custom_progress"
                android:progress="50" />
                
        </LinearLayout>

        <!-- Nút Hành động -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditFromDetail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="SỬA THÔNG TIN"
            android:textColor="@color/phui_bg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeleteFromDetail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_input"
            android:text="XÓA CẦU THỦ"
            android:textColor="@color/phui_error"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
