<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <!-- Bong bóng tin nhắn AI (Bên trái) -->
    <LinearLayout
        android:id="@+id/layoutAiMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:layout_marginEnd="40dp">
        <TextView
            android:id="@+id/tvAiText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/phui_text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>

    <!-- Bong bóng tin nhắn User (Bên phải) -->
    <LinearLayout
        android:id="@+id/layoutUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_button_primary"
        android:padding="14dp"
        android:layout_marginStart="40dp">
        <TextView
            android:id="@+id/tvUserText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/phui_bg"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
