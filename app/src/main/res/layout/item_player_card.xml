<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:transitionName="player_card_transition">

    <LinearLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvOvr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85"
            android:textColor="@color/phui_accent"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FW"
            android:textColor="@color/phui_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn A"
            android:textColor="@color/phui_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/tvGoals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽ 12 Bàn"
                android:textColor="@color/phui_text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:id="@+id/tvMvp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 3 MVP"
                android:textColor="@color/phui_text_secondary"
                android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvJersey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#9"
        android:textColor="@color/phui_text_secondary"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
