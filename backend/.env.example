# Server
PORT=3000
USE_MOCK_DB=true
CORS_ORIGINS=

# Authentication: use at least 32 random bytes in production.
TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
TOKEN_TTL_SECONDS=86400

# Optional extra client-level guard. Leave empty to use Bearer authentication only.
SERVER_API_KEY=

# Gemini AI (the API returns AI_NOT_CONFIGURED when these are missing).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_OUTPUT_TOKENS=900

# Oracle, used only when USE_MOCK_DB=false.
DB_USER=football_manager
DB_PASSWORD=
DB_CONNECTION_STRING=localhost:1521/FREEPDB1
